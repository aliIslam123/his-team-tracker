# --- Live mode (shared database) ---------------------------------------------
# Leave both empty to run in DEMO mode (data stays in each browser's localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (NEVER exposed to the browser) --------------------------------
# Required for the admin account screens in live mode (creating engineers,
# changing roles, resetting passwords). The NEXT_PUBLIC_ prefix is deliberately
# absent so this key is never included in any client bundle.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode only ------------------------------------------------------------
# Login used on /login when Supabase is NOT configured. Change these for any public demo.
# NEXT_PUBLIC_DEMO_USER=teamhis
# NEXT_PUBLIC_DEMO_PASSWORD=

# --- Production safety ---------------------------------------------------------
# In production the site REFUSES to start in Demo mode (no Supabase env) so a missing variable
# on the host can never expose the demo login. Set this to true ONLY for a deliberate public demo.
# NEXT_PUBLIC_ALLOW_DEMO=false
